import pandas as pd

# 读数并规范列名
df = pd.read_csv(r'C:\Users\giggle\Desktop\延续论文进度\code1\testpoint\point11.csv')
df.columns = [c.strip().lower() for c in df.columns]  # 统一成 x, y, z
for c in ['x', 'y', 'z']:
    df[c] = pd.to_numeric(df[c], errors='coerce')

# 取每个 z 层的 4 个极值“行”的索引
idx = pd.concat([
    df.groupby('z')['x'].idxmin(),
    df.groupby('z')['x'].idxmax(),
    df.groupby('z')['y'].idxmin(),
    df.groupby('z')['y'].idxmax()
]).dropna().astype(int)

# 拼起来 → 按 (x,y,z) 去重 → 排序 → 导出
out = (df.loc[idx, ['x', 'y', 'z']]
         .drop_duplicates(subset=['x', 'y', 'z'])      # 去掉同一层内/层间完全相同的点
         .sort_values(['z', 'x', 'y'])
         .reset_index(drop=True))

# 若浮点误差导致几乎相同但不完全相同，可先四舍五入再去重：
# out = (df.loc[idx, ['x','y','z']]
#          .round({'x':8,'y':8,'z':8})
#          .drop_duplicates()
#          .sort_values(['z','x','y'])
#          .reset_index(drop=True))

out.to_csv('./result_3d_point2.csv', index=False)
