import pandas as pd
import os
from pathlib import Path

def pick_column(columns, candidates):
    """
    在 columns 中查找 candidates 里的候选词，返回第一个找到的。
    如果都没找到，返回 None。
    """
    # 统一转小写比较
    cols_lower = [c.strip().lower() for c in columns]
    col_map = dict(zip(cols_lower, columns)) # 映射回原始列名

    for cand in candidates:
        if cand in col_map:
            return col_map[cand]
    return None

def process_files(input_path_str, output_path_str=None):
    # 1. 设置输入路径
    input_dir = Path(input_path_str)
    
    # 2. 设置输出路径 (如果有指定则使用指定路径，否则默认在原目录下建 results)
    if output_path_str:
        output_dir = Path(output_path_str)
    else:
        output_dir = input_dir / 'results'
    
    if not input_dir.exists():
        print(f"错误: 找不到输入目录: {input_dir}")
        return

    # 自动创建输出目录
    output_dir.mkdir(parents=True, exist_ok=True)
    print(f"📁 结果将保存到: {output_dir}")

    # 3. 获取所有支持的文件 (csv, xls, xlsx)
    files = []
    for ext in ['*.csv', '*.xls', '*.xlsx']:
        files.extend(list(input_dir.glob(ext)))

    if not files:
        print("未找到任何 CSV 或 Excel 文件。")
        return

    print(f"开始处理，共发现 {len(files)} 个文件...")

    # 4. 遍历文件
    for file in files:
        # 跳过之前生成的结果文件 (防止把结果文件又读了一遍)
        if file.name.endswith('_out.csv'):
            continue

        print(f'正在处理: {file.name}')

        try:
            # --- A. 智能读取 ---
            if file.suffix.lower() == '.csv':
                df0 = pd.read_csv(file)
            elif file.suffix.lower() == '.xls':
                # 针对 .xls 文件，添加 convert_float=False 防止 NaN 转 int 报错
                df0 = pd.read_excel(file, convert_float=False)
            else:
                # 针对 .xlsx
                df0 = pd.read_excel(file)
            
            # 去除列名空格
            df0.columns = [str(c).strip() for c in df0.columns]

            # --- B. 智能列名映射 ---
            # 定义候选词库
            x_cands = ['x', 'point_x', 'coord_x', 'east']
            y_cands = ['y', 'point_y', 'coord_y', 'north']
            z_cands = ['z', 'point_z', 'coord_z', 'elev', 'elevation', 'alt', 'height']

            x_col = pick_column(df0.columns, x_cands)
            y_col = pick_column(df0.columns, y_cands)
            z_col = pick_column(df0.columns, z_cands)

            # 检查是否找齐了三剑客
            if not all([x_col, y_col, z_col]):
                print(f"  [跳过] 缺少必要列。检测结果: X={x_col}, Y={y_col}, Z={z_col}")
                print(f"  (文件包含列名: {list(df0.columns)})")
                continue

            # 提取并重命名
            df = df0[[x_col, y_col, z_col]].rename(columns={x_col:'x', y_col:'y', z_col:'z'})

            # --- C. 数据清洗与类型转换 ---
            for c in ['x', 'y', 'z']:
                # 防御性代码：如果读出来是 DataFrame (重复列名导致)，取第一列
                if isinstance(df[c], pd.DataFrame):
                    df[c] = df[c].iloc[:, 0]
                
                # 强制转数值
                df[c] = pd.to_numeric(df[c], errors='coerce')

            # 删除空值
            df_clean = df.dropna(subset=['x', 'y', 'z'])

            if df_clean.empty:
                print(f"  [跳过] 数值化后无有效数据: {file.name}")
                continue

            # --- D. 核心计算 (极值提取) ---
            # 按 Z 分组，提取 X 和 Y 的最大最小值的索引
            idx_list = [
                df_clean.groupby('z')['x'].idxmin(),
                df_clean.groupby('z')['x'].idxmax(),
                df_clean.groupby('z')['y'].idxmin(),
                df_clean.groupby('z')['y'].idxmax()
            ]

            # 合并索引
            idx = pd.concat(idx_list).dropna().astype(int)

            # 提取数据，去重，排序
            out = (df_clean.loc[idx, ['x', 'y', 'z']]
                   .drop_duplicates(subset=['x', 'y', 'z'])
                   .sort_values(['z', 'x', 'y'])
                   .reset_index(drop=True))

            # --- E. 保存 ---
            output_file = output_dir / f"{file.stem}_out.csv"
            # 使用 float_format 控制小数位数，避免科学计数法
            out.to_csv(output_file, index=False, float_format="%.6f")
            print(f'  -> 成功保存: {output_file.name} (提取了 {len(out)} 个点)')

        except Exception as e:
            print(f"  [错误] 处理文件 {file.name} 时发生异常: {e}")

    print("\n🎉 全部文件处理完成。")

if __name__ == "__main__":
    # 1. 输入数据的文件夹路径
    input_path = r'C:\Users\giggle\Desktop\data2\excel'
    
    # 2. 输出结果的文件夹路径 (如果文件夹不存在，脚本会自动帮你创建)
    # 你可以改成任何你想要的位置，例如 'D:\Results\ProcessedPoints'
    target_output_path = r'C:\Users\giggle\Desktop\data2\processed_results'
    
    process_files(input_path, target_output_path)