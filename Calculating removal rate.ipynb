import pandas as pd
import os

def batch_compare_with_percentage(xls_folder, csv_folder):
    print(f"--- 开始处理 ---")
    print(f"Excel 目录: {xls_folder}")
    print(f"CSV 目录:   {csv_folder}\n")

    # 获取所有 xls/xlsx 文件
    xls_files = [f for f in os.listdir(xls_folder) if f.lower().endswith(('.xls', '.xlsx'))]
    
    if not xls_files:
        print("错误：在 Excel 文件夹中没有找到任何 .xls 或 .xlsx 文件。")
        return

    # 初始化统计变量
    matched_count = 0
    grand_total_original = 0  # 所有文件的原始点数之和
    grand_total_removed = 0   # 所有文件去除的点数之和
    details = []              # 存储每个文件的详细结果

    print(f"找到 {len(xls_files)} 个 Excel 文件，开始匹配...\n")

    for xls_file in xls_files:
        # 获取文件名（不带后缀），用于去 CSV 文件夹找对应文件
        file_name_no_ext = os.path.splitext(xls_file)[0]
        
        # 构造路径
        xls_full_path = os.path.join(xls_folder, xls_file)
        csv_full_path = os.path.join(csv_folder, file_name_no_ext + ".csv")
        
        # 只有当对应的 CSV 存在时才处理
        if os.path.exists(csv_full_path):
            try:
                # 1. 读取 Excel (header=None 保证读取所有行)
                df_xls = pd.read_excel(xls_full_path, header=None)
                
                # 2. 读取 CSV (尝试不同编码)
                try:
                    df_csv = pd.read_csv(csv_full_path, header=None, encoding='utf-8')
                except UnicodeDecodeError:
                    df_csv = pd.read_csv(csv_full_path, header=None, encoding='gbk')
                
                # 3. 计算行数并减去第一行
                # 如果文件只有1行(表头)，减1后为0；防止空文件报错用max(0, ...)
                count_xls = max(0, len(df_xls) - 1)
                count_csv = max(0, len(df_csv) - 1)
                
                removed = count_xls - count_csv
                
                # 累加到总数
                grand_total_original += count_xls
                grand_total_removed += removed
                matched_count += 1
                
                # 记录详情
                print(f"[匹配] {file_name_no_ext:<20} | 原: {count_xls} -> 剩: {count_csv} | 去除: {removed}")
                
                details.append({
                    'File': file_name_no_ext,
                    'Original': count_xls,
                    'Filtered': count_csv,
                    'Removed': removed
                })

            except Exception as e:
                print(f"[错误] 读取文件 {file_name_no_ext} 时出错: {e}")
        # else: print(f"跳过: {xls_file} (未找到对应CSV)")

    # --- 最终计算结果 ---
    print("\n" + "="*40)
    print("           最终统计结果")
    print("="*40)
    
    if matched_count > 0:
        # 计算平均去除量
        avg_removed = grand_total_removed / matched_count
        
        # 计算百分比
        if grand_total_original > 0:
            removed_percentage = (grand_total_removed / grand_total_original) * 100
        else:
            removed_percentage = 0.0

        print(f"1. 成功对比文件组数:  {matched_count} 组")
        print(f"2. 原始点总数 (Sum):  {grand_total_original}")
        print(f"3. 去除点总数 (Sum):  {grand_total_removed}")
        print(f"4. 平均每份去除:      {avg_removed:.2f} 个")
        print("-" * 40)
        print(f"★ 总体去除百分比:     {removed_percentage:.2f}%")
        print("=" * 40)
        
        # 保存结果
        output_csv = '对比结果_含百分比.csv'
        pd.DataFrame(details).to_csv(output_csv, index=False, encoding='utf-8-sig')
        print(f"\n详细清单已保存至: {output_csv}")
        
    else:
        print("未成功匹配任何文件，请检查文件夹路径或文件名是否一致。")

