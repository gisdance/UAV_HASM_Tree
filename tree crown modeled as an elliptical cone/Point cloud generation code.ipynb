import numpy as np

def generate_positive_crown_data():
    print(">>> 正在生成【全正值坐标 & 高密度】验证数据...")
    print(">>> (已将树心平移至 (10, 10)，消除 X,Y 轴负值)")
    print("=" * 60)

    # 平移偏移量 (Offset)
    X_OFFSET = 10.0
    Y_OFFSET = 10.0

    # =======================================================
    # 模型 1: 规则针叶树冠 (Cone)
    # =======================================================
    filename1 = "Crown_Positive_Cone.txt"
    H1 = 5.0
    R1 = 2.5
    N1 = 8800     # 高密度 200 pts/m^2
    Noise1 = 0.05 # 5cm 噪声

    # --- 生成侧面 ---
    h_rand = np.random.uniform(0, H1, int(N1 * 0.95))
    r_at_h = R1 * (H1 - h_rand) / H1
    theta = np.random.uniform(0, 2*np.pi, len(h_rand))
    
    x1 = r_at_h * np.cos(theta)
    y1 = r_at_h * np.sin(theta)
    z1 = h_rand

    # --- 生成底部边缘圈 (Ring) ---
    n_ring = int(N1 * 0.05)
    theta_ring = np.random.uniform(0, 2*np.pi, n_ring)
    x_ring = R1 * np.cos(theta_ring)
    y_ring = R1 * np.sin(theta_ring)
    z_ring = np.zeros(n_ring)

    # 合并
    x_all = np.concatenate([x1, x_ring])
    y_all = np.concatenate([y1, y_ring])
    z_all = np.concatenate([z1, z_ring])

    # 【关键步骤】加入偏移量，消除负值
    x_all += X_OFFSET
    y_all += Y_OFFSET

    # 加噪声
    pts1 = np.vstack([x_all, y_all, z_all]).T
    pts1 += np.random.normal(0, Noise1, pts1.shape)
    
    # 再次强制检查：如果加噪声后偶尔出现负数(极小概率)，强制修剪为0.001
    pts1[pts1 < 0] = 0.001

    np.savetxt(filename1, pts1, fmt="%.4f", delimiter=",")

    # =======================================================
    # 模型 2: 阔叶/灌木树冠 (Paraboloid)
    # =======================================================
    filename2 = "Crown_Positive_Paraboloid.txt"
    H2 = 4.0
    R2 = 3.0
    N2 = 9800     # 高密度 200 pts/m^2
    Noise2 = 0.08 # 8cm 噪声

    # --- 生成侧面 ---
    r_rand2 = np.sqrt(np.random.uniform(0, R2**2, int(N2 * 0.95)))
    theta2 = np.random.uniform(0, 2*np.pi, len(r_rand2))
    
    x2 = r_rand2 * np.cos(theta2)
    y2 = r_rand2 * np.sin(theta2)
    z2 = H2 * (1 - (r_rand2**2)/(R2**2))

    # --- 生成底部边缘圈 ---
    n_ring2 = int(N2 * 0.05)
    theta_ring2 = np.random.uniform(0, 2*np.pi, n_ring2)
    x_ring2 = R2 * np.cos(theta_ring2)
    y_ring2 = R2 * np.sin(theta_ring2)
    z_ring2 = np.zeros(n_ring2)

    # 合并
    x_all2 = np.concatenate([x2, x_ring2])
    y_all2 = np.concatenate([y2, y_ring2])
    z_all2 = np.concatenate([z2, z_ring2])

    # 【关键步骤】加入偏移量
    x_all2 += X_OFFSET
    y_all2 += Y_OFFSET

    # 加噪声
    pts2 = np.vstack([x_all2, y_all2, z_all2]).T
    pts2 += np.random.normal(0, Noise2, pts2.shape)
    pts2[pts2 < 0] = 0.001 # 兜底防止负值

    np.savetxt(filename2, pts2, fmt="%.4f", delimiter=",")

    # =======================================================
    # 真值 (完全不变，因为体积只看形状，不看位置)
    # =======================================================
    Vol_True_1 = (1/3) * np.pi * (R1**2) * H1
    Area_True_1 = np.pi * R1 * np.sqrt(R1**2 + H1**2)

    Vol_True_2 = (1/2) * np.pi * (R2**2) * H2
    Area_True_2 = (np.pi * R2 / (6 * H2**2)) * (np.power(R2**2 + 4*H2**2, 1.5) - np.power(R2, 3))

    print(f"✅ 全正值数据生成完毕！(中心点已移至 x=10, y=10)")
    print("-" * 50)
    print(f"【模型 A: 针叶树 (Cone)】")
    print(f"  - 文件: {filename1}")
    print(f"  - 坐标范围: X[{np.min(pts1[:,0]):.2f}, {np.max(pts1[:,0]):.2f}]")
    print(f"  - 真值体积: {Vol_True_1:.4f} m³")
    print(f"  - 真值表面积: {Area_True_1:.4f} m²")
    print("-" * 50)
    print(f"【模型 B: 灌木 (Paraboloid)】")
    print(f"  - 文件: {filename2}")
    print(f"  - 坐标范围: X[{np.min(pts2[:,0]):.2f}, {np.max(pts2[:,0]):.2f}]")
    print(f"  - 真值体积: {Vol_True_2:.4f} m³")
    print(f"  - 真值表面积: {Area_True_2:.4f} m²")
    print("=" * 60)

if __name__ == "__main__":
    generate_positive_crown_data()

import geopandas as gpd
from shapely.geometry import Point
import os

def generate_aligned_shapefiles():
    print(">>> 正在生成与【正值坐标点云】对齐的 Shapefile...")
    print(">>> (中心点: X=10.0, Y=10.0)")
    print("=" * 60)
    
    # 1. 定义新的中心点 (必须与点云平移后的中心一致)
    center_x = 10.0
    center_y = 10.0
    center_point = Point(center_x, center_y)

    # ==========================================
    # 形状 A: 针叶树边界 (Pine/Cone)
    # 半径 R = 2.5m
    # ==========================================
    R_pine = 2.5
    # 生成圆形几何体
    poly_pine = center_point.buffer(R_pine)
    
    # 创建 GeoDataFrame
    gdf_pine = gpd.GeoDataFrame(
        {'ID': [1], 'Type': ['Pine_Cone_Positive'], 'Radius': [R_pine]}, 
        geometry=[poly_pine]
    )
    
    # 保存
    name_pine = "Boundary_Pine_Pos_R2.5.shp"
    gdf_pine.to_file(name_pine)
    print(f"✅ 已生成: {name_pine}")
    print(f"   - 范围: X[{center_x-R_pine} ~ {center_x+R_pine}], Y[{center_y-R_pine} ~ {center_y+R_pine}]")

    # ==========================================
    # 形状 B: 灌木边界 (Shrub/Paraboloid)
    # 半径 R = 3.0m
    # ==========================================
    R_shrub = 3.0
    poly_shrub = center_point.buffer(R_shrub)
    
    gdf_shrub = gpd.GeoDataFrame(
        {'ID': [2], 'Type': ['Shrub_Para_Positive'], 'Radius': [R_shrub]}, 
        geometry=[poly_shrub]
    )
    
    name_shrub = "Boundary_Shrub_Pos_R3.0.shp"
    gdf_shrub.to_file(name_shrub)
    print("-" * 50)
    print(f"✅ 已生成: {name_shrub}")
    print(f"   - 范围: X[{center_x-R_shrub} ~ {center_x+R_shrub}], Y[{center_y-R_shrub} ~ {center_y+R_shrub}]")
    
    print("=" * 60)
    print(">>> 提示: 现在将生成的 .txt 点云和 .shp 拖入 GIS 软件，它们应该完美重合！")

if __name__ == "__main__":
    generate_aligned_shapefiles()