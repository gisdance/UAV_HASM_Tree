import leafmap
import os
from samgeo import SamGeo
# 4. 指定你自己的影像路径
image = '/content/drive/MyDrive/lunw/test80.tif'
m = leafmap.Map()
    # 6. 添加你的栅格影像
    # leafmap 会自动读取影像的地理信息 (CRS 和 BBox)
    # 并将地图视图缩放到你的影像范围
m.add_raster(image, layer_name="我自己的影像")
m


sam = SamGeo(
    model_type = "vit_h" ,
    checkpoint = "sam_vit_h_4b8939.pth " ,
    sam_kwargs = None )
#sam.set_image(image)
mask = "segment.tif"
sam.generate ( image , mask , batch = True , foreground = True , erosion_kernel = ( 3 , 3 ) , mask_multiplier = 255 )
vector = "segment.gpkg"
sam.tiff_to_gpkg(mask, vector, simplify_tolerance=None)

shapefile = "segment.shp"
sam.tiff_to_vector(mask, shapefile)
style = { "color": "#3388ff", "weight": 2, "fillColor": "#7c4185", "fillOpacity": 0.5, }
m.add_vector(vector, layer_name="Vector", style=style)
m