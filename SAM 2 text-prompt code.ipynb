import leafmap 
import os
#from samgeo import SamGeo
from samgeo.common import tms_to_geotiff, split_raster
from samgeo.text_sam import LangSAM
from samgeo import SamGeo2

# 4. 指定你自己的影像路径
image = '/content/drive/MyDrive/lunw/test80.tif'
m = leafmap.Map()
    # 6. 添加你的栅格影像
    # leafmap 会自动读取影像的地理信息 (CRS 和 BBox)
    # 并将地图视图缩放到你的影像范围
m.add_raster(image, layer_name="我自己的影像")
m


#sam = LangSAM()
sam = LangSAM(model_type="sam2-hiera-large")
#sam = LangSAM(model_type="sam2-hiera-large")

text_prompt = "individual tree"
sam.predict(
    image, 
    text_prompt, 
    box_threshold=0.24, # 示例：指定边界框阈值
    text_threshold=0.24  # 示例：指定文本阈值
)

# 可选：显示分割结果
#sam.show_anns(cmap="Greens", add_boxes=False, alpha=0.5, title="树木自动分割", )
sam.show_anns(
    cmap="Greens",
    add_boxes=False,
    alpha=0.5,
    title="Automatic Segmentation of Trees",
)
sam.show_anns(
    cmap="Greys_r",
    add_boxes=False,
    alpha=1,
    title="Automatic Segmentation of Trees",
    blend=False,
    output="trees.tif",
)
#da,gdf​​= sam.region_groups( image="trees.tif", min_size=100, out_csv="objects.csv", out_image="objects.tif", out_vector="objects.gpkg", )
da, gdf = sam.region_groups(
    image="trees.tif", 
    min_size=100, 
    out_csv="objects.csv", 
    out_image="objects.tif", 
    out_vector="objects.gpkg"
)

m.add_raster("objects.tif", layer_name="Trees", palette="Greens", opacity=0.5, nodata=0)
style = {
    "color": "#3388ff",
    "weight": 2,
    "fillColor": "#7c4185",
    "fillOpacity": 0.5,
}
m.add_vector("objects.gpkg", layer_name="Vector", style=style)
m

