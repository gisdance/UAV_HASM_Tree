import pandas as pd
import numpy as np
import os
from scipy.signal import find_peaks, savgol_filter

# --- 核心函数 1: CSV 文件加载 (不变) ---
def load_csv_data(file_path):
    """从 CSV 文件加载 XYZ 坐标数据。"""
    try:
        df = pd.read_csv(file_path, header=0, sep=',')
        if df.shape[1] < 3:
             raise ValueError("CSV 文件至少需要 3 列用于 X, Y, Z 坐标。")
        points = df.iloc[:, :3].values
        return points
        
    except Exception as e:
        print(f"    [错误] 加载文件 {file_path} 出错: {e}。")
        return None

# --- 核心函数 2: 基于最大点数峰值高度区间的分割 (不变) ---
def process_by_histogram_analysis_final(points, min_points_in_segment=50):
    """
    通用自适应算法：通过 Z 轴直方图分析，找到点数最多的峰值所覆盖的高度区间，并保留。
    """
    total_original_points = len(points)
    z_values = points[:, 2]

    # 步骤 A: 强制精细直方图分箱
    z_range = np.ptp(z_values)
    MIN_Z_RESOLUTION = 0.05 
    num_bins = int(z_range / MIN_Z_RESOLUTION) if z_range > 0 else 50
    if num_bins < 50: num_bins = 50 

    hist, bin_edges = np.histogram(z_values, bins=num_bins)

    # 步骤 B: 平滑直方图并识别峰谷
    window_len = min(11, num_bins // 2 * 2 + 1)
    if window_len < 3: window_len = 3

    try:
        hist_smoothed = savgol_filter(hist, window_length=window_len, polyorder=3)
    except ValueError:
        hist_smoothed = hist

    # 识别峰值
    peaks, _ = find_peaks(hist_smoothed, prominence=np.mean(hist_smoothed) * 0.5, height=0)

    if len(peaks) < 1:
        return points
        
    # --- 步骤 C: 识别最大点数峰值并确定高度区间 ---
    
    peak_data = []
    
    # 遍历所有峰值，计算每个峰值所覆盖区域的点数
    for i in range(len(peaks)):
        current_peak_index = peaks[i]
        
        # 1. 查找左侧谷底索引
        if i == 0:
            left_valley_index = 0
        else:
            left_peak_index = peaks[i-1]
            left_valley_index = np.argmin(hist_smoothed[left_peak_index : current_peak_index]) + left_peak_index
        
        # 2. 查找右侧谷底索引
        if i == len(peaks) - 1:
            right_valley_index = num_bins - 1
        else:
            right_peak_index = peaks[i+1]
            right_valley_index = np.argmin(hist_smoothed[current_peak_index : right_peak_index]) + current_peak_index

        # 3. 计算该峰值区间 (谷底到谷底) 的点数总和
        segment_point_count = np.sum(hist[left_valley_index : right_valley_index + 1])
        
        # 获取 Z 轴的分割高度
        left_split_height = (bin_edges[left_valley_index] + bin_edges[left_valley_index + 1]) / 2
        right_split_height = (bin_edges[right_valley_index] + bin_edges[right_valley_index + 1]) / 2
        
        peak_data.append({
            'count': segment_point_count,
            'z_min': left_split_height,
            'z_max': right_split_height
        })

    # 4. 找到点数最多的峰值 (这应该是树冠主体)
    main_peak = max(peak_data, key=lambda x: x['count'])
    
    z_min_retained = main_peak['z_min']
    z_max_retained = main_peak['z_max']
    
    print(f"    主要峰值点数: {main_peak['count']}")
    print(f"    保留高度区间: Z 介于 {z_min_retained:.2f} 和 {z_max_retained:.2f} 之间")

    # 5. 保留 Z 轴位于主体峰值高度区间内的所有点
    retained_mask = (z_values >= z_min_retained) & (z_values <= z_max_retained)
    final_retained_points = points[retained_mask]
    final_retained_size = len(final_retained_points)
    
    # 步骤 D: 统计和保护机制
    if final_retained_size < min_points_in_segment:
        # 如果保留的点太少，可能切错了，保留原始点
        final_retained_points = points
        final_retained_size = total_original_points
        
    final_retained_percentage = (final_retained_size / total_original_points) * 100
    
    print("\n--- 全局处理结果统计 ---")
    print(f"原始总点数: {total_original_points}")
    print(f"最终保留点数: {final_retained_size}")
    print(f"**最终保留占比: {final_retained_percentage:.2f}%**")
    print(f"**最终移除占比: {(100.0 - final_retained_percentage):.2f}%**")
    
    return final_retained_points

# --- 批量处理主逻辑 (无合并) ---
if __name__ == "__main__":
    
    # ----------------------------------------------------
    # 🚨 绝对路径配置区域：
    # ----------------------------------------------------
    INPUT_DIR = r"D:\data\data3\lidarcsv" 
    OUTPUT_DIR = r"D:\hasm_lunwen\new\treefi2" 
    
    MIN_POINTS_TO_RETAIN = 50 
    # ----------------------------------------------------
    
    # 检查所需的库
    try:
        from scipy.signal import find_peaks, savgol_filter
    except ImportError:
        print("错误：需要安装 SciPy 库。请运行 'conda install scipy'。")
        exit()

    # 创建输出目录
    if not os.path.exists(OUTPUT_DIR):
        try:
            os.makedirs(OUTPUT_DIR)
            print(f"成功创建输出目录: {OUTPUT_DIR}")
        except Exception as e:
            print(f"错误：无法创建输出目录 {OUTPUT_DIR}。请检查权限或路径设置。错误信息: {e}")
            exit()

    # 获取所有 CSV 文件
    try:
        all_files = [f for f in os.listdir(INPUT_DIR) if f.lower().endswith('.csv')]
    except FileNotFoundError:
        print(f"错误：输入目录 '{INPUT_DIR}' 不存在。请检查路径是否正确。")
        exit()
    
    if not all_files:
        print(f"错误：在目录 '{INPUT_DIR}' 中没有找到任何 CSV 文件。")
    else:
        print(f"\n--- 找到 {len(all_files)} 个文件，开始批量处理 ---")
        
        for filename in all_files:
            input_path = os.path.join(INPUT_DIR, filename)
            output_path = os.path.join(OUTPUT_DIR, f"processed_{filename}") # 每个文件单独保存
            
            print(f"\n[文件] 正在处理: {filename}")
            
            points_original = load_csv_data(input_path)

            if points_original is not None:
                total_points = len(points_original)
                print(f"    [成功] 加载 {total_points} 个点。")
                
                # 2. 执行 Z 轴直方图处理
                points_processed = process_by_histogram_analysis_final(
                    points_original,
                    min_points_in_segment=MIN_POINTS_TO_RETAIN
                )

                # 3. 保存结果
                final_retained_size = len(points_processed)
                
                if final_retained_size > 0:
                    df_processed = pd.DataFrame(points_processed, columns=['X', 'Y', 'Z'])
                    df_processed.to_csv(output_path, index=False) 
                    
                    # 打印单文件处理统计
                    retained_percent = (final_retained_size / total_points) * 100
                    removed_percent = 100.0 - retained_percent
                    
                    print(f"    [完成] 保留点数: {final_retained_size} ({retained_percent:.2f}%)")
                    print(f"    [移除] 移除点数: {total_points - final_retained_size} ({removed_percent:.2f}%)")
                    print(f"    [保存] 结果已保存到: {output_path}")
                else:
                    print("    [失败] 处理后没有保留任何点。")
            
        print("\n--- 所有文件处理完毕 ---")